# Example environment variables for Pixie.
# Copy this file to .env and add your real API key.
# Do NOT commit your real API key to version control.

GEMINI_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Optional: override the preferred Gemini model. Supported default is gemini-2.5-flash.
# Use a model that is available in your Google Cloud project.
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback model if the preferred model is unavailable.
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# ThinkSpeak Configuration for ESP32 Sensor Data
# Get these from https://thingspeak.com
THINKSPEAK_CHANNEL_ID=YOUR_THINKSPEAK_CHANNEL_ID
THINKSPEAK_API_KEY=YOUR_THINKSPEAK_READ_API_KEY
